{
  "name": "runesswap.app",
  "version": "0.2.8",
  "private": true,
  "scripts": {
    "test": "NODE_OPTIONS=\"--max-old-space-size=4096\" jest --runInBand",
    "dev": "next dev",
    "build": "./scripts/run-next-build.sh",
    "start": "next start",
    "lint": "biome lint .",
    "lint:architecture": "node scripts/lint-architecture.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint-staged": "lint-staged",
    "type-check": "tsc --noEmit",
    "knip": "knip --config knip.json --reporter compact --no-progress",
    "ai-check": "bun run lint && bun run lint:architecture && bun run format:check && bun run type-check && bun run knip && bun run test && bun run build",
    "pre-commit-check": "bun run type-check && bun run test",
    "prepare": "husky",
    "gen:liquidium-sdk": "openapi -i liquidium-openapi/liquidium-instant-loan-api.yaml -o src/sdk/liquidium --client fetch --useOptions --useUnionTypes --exportSchemas true --name LiquidiumApi"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.9"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@omnisat/lasereyes": "^0.0.163",
    "@satsterminal-sdk/swaps": "1.6.27",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/analytics": "^1.6.1",
    "big.js": "^7.0.1",
    "bitcoin-address-validation": "^2.2.3",
    "next": "16.1.6",
    "ordiscan": "^1.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "use-debounce": "^10.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@next/bundle-analyzer": "^16.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/big.js": "^6.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^6.4.1",
    "lint-staged": "^16.2.7",
    "openapi-typescript-codegen": "^0.30.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,md,yml,yaml}": [
      "biome check --write"
    ]
  },
  "packageManager": "bun@1.3.9",
  "overrides": {
    "axios": "1.13.5",
    "diff": "4.0.4",
    "esbuild": "0.25.0",
    "lodash": "4.17.23",
    "valibot": "1.2.0"
  }
}
