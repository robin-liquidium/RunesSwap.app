{
  "name": "runesswap.app",
  "version": "0.2.8",
  "private": true,
  "scripts": {
    "test": "NODE_OPTIONS=\"--max-old-space-size=4096\" jest --runInBand",
    "dev": "next dev",
    "build": "./scripts/run-next-build.sh",
    "start": "next start",
    "lint": "biome lint .",
    "lint:architecture": "node scripts/lint-architecture.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint-staged": "lint-staged",
    "type-check": "node node_modules/typescript/bin/tsc --noEmit",
    "knip": "knip --config knip.json --reporter compact --no-progress",
    "ai-check": "bun run lint && bun run lint:architecture && bun run format:check && bun run type-check && bun run knip && bun run test && bun run build",
    "pre-commit-check": "bun run type-check && bun run test",
    "prepare": "husky",
    "gen:liquidium-sdk": "openapi -i liquidium-openapi/liquidium-instant-loan-api.yaml -o src/sdk/liquidium --client fetch --useOptions --useUnionTypes --exportSchemas true --name LiquidiumApi"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@omnisat/lasereyes": "^0.0.163",
    "@satsterminal-sdk/swaps": "1.6.31",
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "big.js": "^7.0.1",
    "bitcoin-address-validation": "^3.0.0",
    "next": "16.2.12",
    "ordiscan": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@next/bundle-analyzer": "^16.2.12",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/big.js": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "base58-js": "^3.0.3",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "openapi-typescript-codegen": "^0.31.0",
    "typescript": "^7.0.2",
    "vite": "8.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss}": [
      "biome check --write"
    ]
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@babel/core": "7.29.7",
    "axios": "1.18.1",
    "bn.js": "5.2.5",
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.8",
    "diff": "9.0.0",
    "esbuild": "0.28.1",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "minimatch": "3.1.4",
    "path-to-regexp": "0.1.13",
    "picomatch": "2.3.2",
    "postcss": "8.5.23",
    "qs": "6.15.3",
    "rollup": "4.62.3",
    "sharp": "0.35.3",
    "valibot": "1.4.2",
    "vite": "8.1.5",
    "ws": "8.21.1",
    "yaml": "2.9.0"
  },
  "patchedDependencies": {
    "brace-expansion@5.0.8": "patches/brace-expansion@5.0.8.patch"
  }
}
